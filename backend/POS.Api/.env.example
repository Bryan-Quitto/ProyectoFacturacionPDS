# Database Configuration (Supabase PostgreSQL - Single Source of Truth)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# JWT Configuration
JWT_SECRET=your_super_secret_key_minimum_32_characters_long_12345
JWT_ISSUER=POS.Api
JWT_AUDIENCE=POS.Client
JWT_EXPIRATION_MINUTES=480

# Business Configuration
TAX_PERCENTAGE=0.15
